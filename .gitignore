.venv/
__pycache__/
*.egg-info/
.pytest_cache/
dist/
build/
node_modules/

# generated corpus samples and downloaded tools — rebuild with corpus/build.py
corpus/out/
corpus/tools/

# local Claude Code session state (worktrees would commit as broken gitlinks)
.claude/

# the built frontend, staged into the package by tools/build_ui.py before a
# wheel is built — generated output, rebuilt from web/ on demand
src/binviz/webui/

# the window icon, staged from packaging/icons/ by the same tool. Copied
# rather than committed so there is only one canonical set of branding.
src/binviz/icons/

# the measured thresholds, staged from corpus/calibration.json by the same
# tool so an installed binviz does not fall back to hardcoded ones. Same
# rule: corpus/calibrate.py owns the canonical copy.
src/binviz/calibration.json
